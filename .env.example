# Copy to .env and fill in what you need. All optional.

# Extra folders the server may access, separated by ';' (Downloads, Desktop and Documents are always allowed)
HWP_MCP_ROOTS=
# HTTP mode only: public host name(s) of your tunnel, comma-separated (e.g. mypc.tailnet-name.ts.net)
HWP_MCP_PUBLIC_HOSTS=
# 1 = only find/read/preview tools (recommended if the HTTP server is reachable from the internet)
HWP_MCP_READONLY=
# HTTP mode only: 1 = allow remote callers to open documents in a Hangul window on this PC
HWP_MCP_REMOTE_OPEN=
# Where hwp_create saves new documents (default: Documents\Claude 한글문서)
HWP_MCP_NEW_DIR=
# Keep the hidden Hangul running this many minutes after the last use (default 30)
HWP_MCP_KEEP_WARM_MIN=
# 0 = don't start Hangul in the background on find/read (saves memory, first preview/edit is slower)
HWP_MCP_PREWARM=
# HTTP port (default 8772)
HWP_MCP_PORT=
